# =============================================================================
# ARIA — Environment Configuration
# Copy this file to .env and fill in the values you need.
# All keys are optional unless marked (REQUIRED).
# =============================================================================

# ---------------------------------------------------------------------------
# LLM Provider (REQUIRED — choose one)
# Options: openrouter | openai | anthropic | ollama
# ---------------------------------------------------------------------------
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Local LLM via Ollama (no API key — install Ollama first)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# LLM generation parameters
LLM_MAX_TOKENS=
LLM_TEMPERATURE=0.1
LLM_CLEAN_MAX_WORDS=

# Multi-model ensemble — query multiple LLMs in parallel, merge results
LLM_ENSEMBLE_ENABLED=false

# ---------------------------------------------------------------------------
# Web Search
# At least one recommended; falls back to DuckDuckGo (no key) if both empty
# ---------------------------------------------------------------------------
SERPAPI_KEY=
# BING_SEARCH_KEY=         # alternative to SerpAPI

# ---------------------------------------------------------------------------
# News Collectors
# Without keys, falls back to 10 built-in RSS feeds (BBC, Reuters, AP, etc.)
# ---------------------------------------------------------------------------
NEWS_API_KEY=              # https://newsapi.org/  (free tier: 100 req/day)
GNEWS_API_KEY=             # https://gnews.io/     (free tier: 100 req/day)

# ---------------------------------------------------------------------------
# GitHub Collector
# Without token: 60 req/hr unauthenticated. With token: 5000 req/hr
# ---------------------------------------------------------------------------
GITHUB_TOKEN=              # https://github.com/settings/tokens (read:public_repo)

# ---------------------------------------------------------------------------
# Government / Policy Collector
# Without key, uses data.gov and .gov DuckDuckGo — no key needed
# ---------------------------------------------------------------------------
REGULATIONS_GOV_KEY=       # https://open.fda.gov/apis/authentication/

# ---------------------------------------------------------------------------
# Academic Platform Collectors (all optional — use any combination)
# Without keys, falls back to DuckDuckGo + open-access routes
# ---------------------------------------------------------------------------
IEEE_API_KEY=              # https://developer.ieee.org/
ELSEVIER_API_KEY=          # https://dev.elsevier.com/
SPRINGER_API_KEY=          # https://dev.springernature.com/

# Session cookies for paywalled platforms (copy from browser DevTools)
JSTOR_SESSION_COOKIE=      # Cookie header value from jstor.org
ACM_SESSION_COOKIE=        # Cookie header value from dl.acm.org

# Unpaywall — used to find open-access versions of paywalled papers
# REQUIRED by Unpaywall TOS: https://unpaywall.org/terms — use your real email
UNPAYWALL_EMAIL=your@email.com

# ---------------------------------------------------------------------------
# New Academic Sources
# ---------------------------------------------------------------------------
CORE_API_KEY=              # CORE.ac.uk — optional, higher rate limits (free at core.ac.uk/api-keys)

# ---------------------------------------------------------------------------
# New Specialized Sources
# ---------------------------------------------------------------------------
PROPUBLICA_API_KEY=        # ProPublica Congress API (free at propublica.org/datastore)
                           # Without key: Nonprofit Explorer still works

# ---------------------------------------------------------------------------
# New Social Sources
# ---------------------------------------------------------------------------
MASTODON_ACCESS_TOKEN=     # Optional: mastodon.social — higher rate limits for search

# ---------------------------------------------------------------------------
# Podcast Collector — audio transcription (disabled by default, CPU-heavy)
# Requires: pip install openai-whisper
# Model sizes: tiny | base | small | medium | large  (larger = more accurate)
# ---------------------------------------------------------------------------
PODCAST_TRANSCRIBE=false
WHISPER_MODEL=base

# ---------------------------------------------------------------------------
# Multilingual Collector
# Comma-separated region codes for DuckDuckGo regional search
# Default: de-de,fr-fr,es-es,zh-cn
# Options: us-en, de-de, fr-fr, es-es, ja-jp, zh-cn, pt-br, ar-xa, ru-ru
# ---------------------------------------------------------------------------
MULTILINGUAL_REGIONS=de-de,fr-fr,es-es,zh-cn

# ---------------------------------------------------------------------------
# Intelligence Features (all enabled by default)
# Set to false to disable for faster/lighter runs
# ---------------------------------------------------------------------------
ARIA_KB_ENABLED=true                # Persistent knowledge base (SQLite)
ARIA_KB_PATH=                       # Custom KB path (default: ~/.aria/knowledge_base/aria_kb.db)
ARIA_SMART_QUERIES=true             # LLM-powered query decomposition
ARIA_SEMANTIC_DEDUP=true            # MinHash + embedding deduplication (needs: datasketch)
ARIA_KNOWLEDGE_GRAPH=true           # Entity/claim extraction + contradiction detection
ARIA_GAP_DETECTION=true             # Detect unanswered questions, trigger second-pass
ARIA_IMAGE_EXTRACTION=true          # Extract and caption images from collected pages
ARIA_STREAMING_CLEAN=false          # Clean documents as collected (experimental)

# NOTE: ARIA_SEMANTIC_DEDUP=true requires 'datasketch' and optionally
# 'sentence-transformers' (downloads ~500MB model on first use).
# Set ARIA_SEMANTIC_DEDUP=false for faster cold starts.

# ---------------------------------------------------------------------------
# Storage & API
# ---------------------------------------------------------------------------
DEFAULT_MISSION_FILE=./missions/examples/default.yaml
CREDENTIALS_FILE=./credentials/credentials.json
SESSION_CACHE_DIR=./credentials/sessions
RUNS_DIR=./data/runs
SHARED_MEMORY_BACKEND=dict         # dict | redis
REDIS_URL=redis://localhost:6379   # only needed if SHARED_MEMORY_BACKEND=redis

ARIA_API_HOST=127.0.0.1
ARIA_API_PORT=8765
ARIA_APP_TITLE=ARIA Studio

# ---------------------------------------------------------------------------
# Docker deployment
# Generate ARIA_API_KEY with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------------
ARIA_API_KEY=your-secret-key-here
ARIA_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
